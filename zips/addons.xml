<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.pvscinema" name="PvS Cinema" version="3.5.0" provider-name="PvS">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.pluginsource" library="main.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="cs_CZ">PvS Cinema – filmy a seriály z Webshare.cz s katalogem z TMDB</summary>
    <description lang="cs_CZ">Katalog filmů a seriálů z TMDB (novinky, populární, trendy, žánry, hodnocení), přehrávání z Webshare.cz s výběrem streamu (kvalita, kodek, audio stopy, bitrate), automatické titulky a hledání z telefonu. Ovládání po vzoru Stream Cinema.</description>
    <platform>all</platform>
    <license>MIT</license>
    <news>3.5.0: Sekce Vánoce (vánoční filmy, pohádky, české a slovenské vánoční filmy, seriály). Upozornění na novou verzi po otevření doplňku.</news>
    <assets>
      <icon>icon_logo.png</icon>
      <fanart>fanart_logo.jpg</fanart>
    </assets>
  </extension>
</addon>

<addon id="repository.pvs" name="PvS Repository" version="1.0.1" provider-name="PvS">
  <extension point="xbmc.addon.repository" name="PvS Repository">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/sperlichp2-png/Kodi-repo/main/zips/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/sperlichp2-png/Kodi-repo/main/zips/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/sperlichp2-png/Kodi-repo/main/zips/</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="cs_CZ">Repozitář s doplňkem PvS Cinema</summary>
    <platform>all</platform>
  </extension>
</addon>
</addons>
